rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Receipts: only the authenticated owner may read or write their own receipts.
    match /users/{userId}/receipts/{receiptId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Subscription status: owner may read; only server-side (Admin SDK / Cloud Function)
    // may write — client writes are denied to prevent Pro-status spoofing.
    match /users/{userId}/subscription/{document} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Deny everything else not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

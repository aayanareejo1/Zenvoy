# Dependencies
node_modules/

# Expo
.expo/
dist/

# Native build output
android/build/
android/app/build/
android/app/.cxx/
android/.gradle/
android/local.properties

# iOS — generated by expo prebuild / EAS Build, do not commit
/ios/
ios/build/
ios/Pods/
ios/DerivedData/

# Local env overrides — never commit these
.env.local
.env*.local
google-services.json
android/app/google-services.json
GoogleService-Info.plist

# Keystores (except debug)
*.keystore
!android/app/debug.keystore

# Production signing credentials — never commit
android/app/keystore.properties

# Misc
*.log
.DS_Store
Thumbs.db
